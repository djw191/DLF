#!/bin/sh
# The DLF command, run from the top of the repository (Unity runs it for the DLF window, on start and before a build):
#   dlf download         takes what is new in DLF.txt, file by file: files changed on this machine are left alone
#   dlf upload           lists the shared files as they are now in DLF.txt and puts them in the bucket
#   dlf reset [PATH...]  throws changes made on this machine away: the shared files, or only the selected ones,
#                        become the ones DLF.txt lists
#   dlf unlock           clears a lock an upload left behind
#   dlf status           prints what the DLF window shows: this machine's files, DLF.txt, and the bucket
#   dlf keypath          prints where this machine's write key is kept
. "$(dirname "$0")/dlf.sh"
command=$1
[ $# -gt 0 ] && shift
case "$command" in
	keypath)
		printf '%s\n' "$keys"
		;;
	download)
		[ -f DLF.txt ] || exit 0
		# Nothing new in DLF.txt since this machine last took it: files changed or deleted here are left alone
		[ "$(cat "$state/synced" 2> /dev/null)" = "$(list_id < DLF.txt)" ] && exit 0
		use_read_key
		sync
		report_conflicts
		;;
	upload)
		branch=$(current_branch) || fail "nothing to upload: no branch is checked out."
		upload "$branch"
		;;
	reset)
		[ -f DLF.txt ] || fail "there is no DLF.txt yet, so there is nothing to reset to."
		use_read_key
		if [ $# -eq 0 ]; then
			sync --all
		else
			sync "$@"
		fi
		report_conflicts
		;;
	unlock)
		use_write_key
		r2 DELETE lock > /dev/null || fail "could not clear the lock."
		echo "DLF: unlocked." >&2
		;;
	status)
		# For the DLF window: one name=value line per fact. The bucket is asked last; when it cannot be reached, the
		# facts about this machine are still there
		echo "project=$project"
		echo "branch=$(current_branch)"
		if [ -f "$keys" ]; then echo "key=write"; elif [ -n "$(value readSecretAccessKey "$cfg")" ]; then echo "key=read"; else echo "key=none"; fi
		if [ -f DLF.txt ]; then
			echo "files=$(wc -l < DLF.txt | tr -d ' ')"
			if [ -z "$(git status --porcelain -- DLF.txt)" ]; then echo "committed=yes"; else echo "committed=no"; fi
			# A commit that changed DLF.txt and is on no remote yet; and one on the branch's remote that is not here yet,
			# as of the last fetch (this asks no server)
			if [ -n "$(git remote)" ] && [ -n "$(git rev-list -n 1 HEAD --not --remotes -- DLF.txt 2> /dev/null)" ]; then echo "pushed=no"; fi
			if [ -n "$(git rev-list -n 1 'HEAD..@{upstream}' -- DLF.txt 2> /dev/null)" ]; then echo "behind=yes"; fi
		fi
		# Per file, as git status does. "changed": this machine's files against the list it last took (added, deleted,
		# or written since). "incoming": that list against DLF.txt, which is what a download would bring
		if [ -f "$state/synced" ] && git cat-file -e "$(cat "$state/synced")" 2> /dev/null; then
			git cat-file blob "$(cat "$state/synced")" | sort > "$work/have"
		else
			: > "$work/have"
		fi
		cut -d' ' -f2- "$work/have" | sort > "$work/have.paths"
		shared_files | tr '\000' '\n' | sort > "$work/here"
		comm -13 "$work/have.paths" "$work/here" | sed 's/^/changed=A /'
		comm -23 "$work/have.paths" "$work/here" | sed 's/^/changed=D /'
		# Modified: there before and now, with another size or time than when this machine last took the list
		seen | sort > "$work/now"
		sort "$state/seen" 2> /dev/null | comm -13 - "$work/now" | cut -d/ -f3- | sort > "$work/touched"
		comm -12 "$work/have.paths" "$work/here" | comm -12 - "$work/touched" | sed 's/^/changed=M /'
		if [ -f DLF.txt ]; then
			tr -d '\r' < DLF.txt | sort > "$work/want"
			comm -13 "$work/have" "$work/want" | cut -d' ' -f2- | sort > "$work/in"
			comm -12 "$work/in" "$work/have.paths" | sed 's/^/incoming=M /'
			comm -23 "$work/in" "$work/have.paths" | sed 's/^/incoming=A /'
			cut -d' ' -f2- "$work/want" | sort | comm -23 "$work/have.paths" - | sed 's/^/incoming=D /'
		fi
		rm -f "$work/have" "$work/have.paths" "$work/here" "$work/want"
		# "status local" stops here: quick, and without asking the bucket
		[ "$1" = local ] && exit 0
		(
			use_read_key 2> /dev/null
			get lock "$work/lock"
			IFS='|' read -r owner since what < "$work/lock" || true
			rm -f "$work/lock"
			if [ -n "$since" ] && [ $(($(date +%s) - since)) -lt $lock_seconds ]; then echo "lock=$owner is uploading $what"; fi
			[ -f DLF.txt ] || exit 0
			get "$(branch_key "$(current_branch)")" "$work/old"
			if [ "$(list_id < "$work/old")" = "$(list_id < DLF.txt)" ]; then echo "uploaded=yes"; else echo "uploaded=no"; fi
			rm -f "$work/old"
		) 2> /dev/null || echo "bucket=unreachable"
		;;
	*)
		fail "unknown command '$command'. Use download, upload, reset, unlock, status or keypath."
		;;
esac
