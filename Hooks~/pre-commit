#!/bin/sh
# On a machine that publishes (it has a write key): when the shared large files changed, DLF.txt is rewritten to name
# the new set and the commit is stopped once, so that DLF.txt can go into the same commit as the changes that need
# the new files. Pushing uploads them (pre-push).
. "$(dirname "$0")/dlf.sh"
[ -f "$keys" ] || exit 0
mkdir -p "$state"
current=$(current_set)
[ -s "$state/index" ] || exit 0
pointer=$(cat DLF.txt 2>/dev/null | tr -d '\r\n')
[ "$current" = "$pointer" ] && exit 0
base=$(cat "$state/base" 2>/dev/null)
# A checkout that never fetched the project's set cannot tell a change from an old copy: it names nothing
[ -n "$pointer" ] && [ -z "$base" ] && exit 0
# The files are still the ones last seen in the bucket: this branch just names another set
[ "$current" = "$base" ] && exit 0
name_current "$current"
# Not staged here: which commit the new set belongs to is the author's call
echo "DLF: the shared large files changed, and DLF.txt now names the new set." >&2
echo "Commit stopped once: stage DLF.txt if this commit should carry the new files, then commit again." >&2
exit 1
