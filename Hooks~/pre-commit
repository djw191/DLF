#!/bin/sh
# A reminder only, on a machine with a write key: it changes nothing and never stops a commit. It speaks up when shared
# large files changed here and were not uploaded, or when DLF.txt changed and is left out of the commit.
. "$(dirname "$0")/dlf.sh"
[ -f "$keys" ] || exit 0
if [ -f "$state/synced" ] && ! unchanged; then
	echo "DLF: shared large files changed on this machine and are not uploaded. If this commit needs them, use Upload in the DLF window (Tools > DLF > DLF) and commit DLF.txt with it." >&2
elif [ -n "$(git diff --name-only -- DLF.txt)" ]; then
	echo "DLF: DLF.txt has changes that are not part of this commit. Stage it if this commit needs the new files." >&2
fi
exit 0
