#!/bin/sh
# On a machine that publishes (it has a write key): a change to DLF.txt never leaves without its files. The bucket
# gets the set first, or the push is refused. Large files that changed here but that no commit names are nobody's
# business yet: they stay local.
. "$(dirname "$0")/dlf.sh"
[ -f "$keys" ] || exit 0
remote=$1
while read -r ref sha remote_ref remote_sha; do
	pointer=$(git show "$sha:DLF.txt" 2> /dev/null | tr -d '\r\n')
	[ -n "$pointer" ] || continue
	# Only a push that brings a change to DLF.txt the remote does not have yet is of interest. A push to an address
	# instead of a named remote is compared with the commit that branch is at there, or with every known remote
	known="--remotes=$remote"
	if ! git config "remote.$remote.url" > /dev/null 2>&1; then
		known=--remotes
		git cat-file -e "$remote_sha^{commit}" 2> /dev/null && known=$remote_sha
	fi
	[ -n "$(git rev-list "$sha" --not "$known" -- DLF.txt 2> /dev/null | head -n 1)" ] || continue
	publish "$pointer" "$ref"
done
